# PostgreSQL connection used by the Flask backend and Alembic.
POSTGRES_DB=consultation_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Flask development server configuration.
FLASK_DEBUG=1

# Server-side AI configuration. Never expose the API key to React.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
